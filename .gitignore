# Python virtual environment
venv/
.venv/

# Node dependencies (installed inside the Docker image by npm install)
node_modules/
npm-debug.log*

# Qualitas Corpus data: several GB, too large for GitHub
BigDataAnalytics/Data/*
!BigDataAnalytics/Data/Place-Qualitas-Corpus-Here.txt
*.tar
*.zip

# MonitorTool samples: test runs stay local, the final run's CSV is copied into the report
BigDataAnalytics/Containers/MonitorTool/data/*
!BigDataAnalytics/Containers/MonitorTool/data/.gitkeep

# Logs and local environment settings
*.log
.env

# Editor and OS files
.vscode/
.idea/
.DS_Store
*.swp
